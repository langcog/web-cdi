# Environment variables for local development with docker-compose.
# Copy this file to .env (which is gitignored) and adjust if needed:
#
#   cp .env.example .env
#
# All variables read by webcdi/webcdi/settings.py are listed here.
# The values below work out of the box with docker-compose.yml.

DEBUG=True

# When True (the production default), settings.py fetches credentials from
# AWS Secrets Manager and uses S3 for file storage. Must be False locally.
AWS_INSTANCE=False

DJANGO_SERVER_TYPE=DEV

# django.contrib.sites ID: 2 = dev server, 3 = local, 4 = MPI
SITE_ID=3

# Bracketed, comma-separated, unquoted (settings.py adds the quotes).
ALLOWED_HOSTS=[localhost,127.0.0.1,0.0.0.0,web]
ADMINS=[(Local Admin,admin@example.com)]

# Database — matches the "db" service in docker-compose.yml.
RDS_ENGINE=django.db.backends.postgresql
RDS_DB_NAME=postgres
RDS_USERNAME=postgres
RDS_PASSWORD=postgres
RDS_HOSTNAME=db
RDS_PORT=5432

# Email. The console backend prints emails to the web container's log.
# Production uses django_ses.SESBackend (the default when unset).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL_NAME=WebCDI Local
DEFAULT_FROM_EMAIL_ADDRESS=webcdi-local@example.com
DEFAULT_RECIPIENT_EMAIL=webcdi-local@example.com
BROOKES_EMAIL=brookes-local@example.com

# pgAdmin service login (docker-compose "pgadmin" service, port 5051).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

TIME_ZONE=America/Los_Angeles

# CAT engine: "browser" runs the validated jsCat engine client-side;
# "remote" (the default) calls the R API per item.
CAT_ENGINE=browser

# Optional overrides (defaults live in settings.py):
# CAT_API_URL=          # R-based CAT server; defaults to the production instance
# AWS_STORAGE_BUCKET_NAME=   # required only when AWS_INSTANCE=True
# TRUSTED_ORIGINS=      # CSRF trusted origins, same bracket format as ALLOWED_HOSTS
# LOG_FILE_PATH=/tmp/
